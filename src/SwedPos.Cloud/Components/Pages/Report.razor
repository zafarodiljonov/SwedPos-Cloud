@page "/{Lang}/r/{Rid:int}/{Page?}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SwedPos.Domain
@inject CloudAccounts Accounts
@inject TenantDatabases Tenants
@inject NavigationManager Nav

<PageTitle>@T("an_page_" + CurrentPage) · @(_restaurant?.Name ?? "SwedPos Cloud")</PageTitle>

<div class="shell">
    <header class="topbar">
        <div class="brand"><span class="brand-mark"></span>SWEDPOS <b>CLOUD</b></div>
        <div class="restaurant">
            @if (_restaurants.Count > 1)
            {
                <select @onchange="SwitchRestaurant" value="@Rid">
                    @foreach (var r in _restaurants)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
            }
            else
            {
                <span class="name">@_restaurant?.Name</span>
            }
            <span class="sync @(SyncFresh ? "ok" : "stale")" title="@T("web_live_note")">
                ● @(_restaurant?.LastSyncAt is { } at ? T("web_last_sync") + ": " + ReportBuilder.Local(at).ToString("dd.MM.yyyy HH:mm") : T("web_never_synced"))
            </span>
        </div>
        <div class="top-actions">
            <a class="lang @(L == "uz" ? "on" : "")" href="@LangHref("uz")" data-enhance-nav="false">UZ</a><a class="lang @(L == "ru" ? "on" : "")" href="@LangHref("ru")" data-enhance-nav="false">RU</a>
            <span class="who">@_accountName</span>
            <a class="btn ghost" href="/logout" data-enhance-nav="false">@T("web_logout")</a>
        </div>
    </header>

    <nav class="pages">
        @foreach (var p in ReportBuilder.Pages)
        {
            <a class="@(p == CurrentPage ? "on" : "")" href="/@L/r/@Rid/@p"><span class="icon">@Icon(p)</span>@T("an_page_" + p)</a>
        }
    </nav>

    <main class="content">
        @if (CurrentPage != "payroll")
        {
            <section class="filters">
                <div class="presets">
                    @foreach (var (key, from, to) in Presets)
                    {
                        <button class="@(_from == from && _to == to ? "on" : "")" @onclick="() => SetPeriod(from, to)">@T(key)</button>
                    }
                </div>
                <div class="dates">
                    <input type="date" @bind="_fromInput" />
                    <span>—</span>
                    <input type="date" @bind="_toInput" />
                    <button class="btn" @onclick="ApplyDates">@T("web_apply")</button>
                </div>
                <div class="selects">
                    <select @bind="_hall" @bind:after="ReloadAsync">
                        <option value="">@T("an_all_halls")</option>
                        @foreach (var h in _halls) { <option value="@h.Id">@h.Name</option> }
                    </select>
                    <select @bind="_waiter" @bind:after="ReloadAsync">
                        <option value="">@T("an_all_waiters")</option>
                        @foreach (var w in _waiters) { <option value="@w.Id">@w.Name</option> }
                    </select>
                    <select @bind="_type" @bind:after="ReloadAsync">
                        <option value="">@T("an_all_types")</option>
                        <option value="DineIn">@T("report_dine_in")</option>
                        <option value="Takeaway">@T("order_type_takeaway")</option>
                        <option value="Delivery">@T("order_type_delivery")</option>
                    </select>
                </div>
            </section>
        }

        <div class="page-head">
            <div>
                <h1>@T("an_page_" + CurrentPage)</h1>
                <p class="dim">@T("an_hint_" + CurrentPage)</p>
            </div>
            <div class="page-side">
                <span class="dim">@PeriodText</span>
                <a class="btn ghost" href="@ExportHref" download data-enhance-nav="false">⭳ @T("report_export")</a>
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="msg error">@_error</p>
        }
        @if (_loading && _built is null)
        {
            <p class="dim">@T("an_loading")</p>
        }
        @if (_built is not null)
        {
            <div class="@(_loading ? "blocks loading" : "blocks")">
                @foreach (var block in _built.Blocks)
                {
                    <BlockView Block="block" Lang="@L" OnDrill="DrillAsync" OnMonth="MonthAsync" />
                }
                @if (_detail is not null)
                {
                    <BlockView Block="_detail" Lang="@L" />
                }
            </div>
        }
    </main>
</div>

@code {
    [Parameter] public string Lang { get; set; } = "uz";
    [Parameter] public int Rid { get; set; }
    [Parameter] public string? Page { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? Auth { get; set; }

    private List<Restaurant> _restaurants = new();
    private Restaurant? _restaurant;
    private string _accountName = "";
    private List<(int Id, string Name)> _halls = new();
    private List<(int Id, string Name)> _waiters = new();

    private DateOnly _from, _to, _fromInput, _toInput;
    private string _hall = "", _waiter = "", _type = "";
    private DateOnly _payMonth;
    private ReportPage? _built;
    private Block? _detail;
    private bool _loading;
    private string? _error;
    private string? _loadedFor;

    private string L => Texts.Normalize(Lang);
    private string T(string key) => Texts.Get(L, key);
    private string CurrentPage => ReportBuilder.Pages.Contains(Page) ? Page! : "overview";
    private bool SyncFresh => _restaurant?.LastSyncAt is { } at && DateTime.UtcNow - at < TimeSpan.FromMinutes(10);

    private IEnumerable<(string Key, DateOnly From, DateOnly To)> Presets
    {
        get
        {
            var today = RestaurantTime.Today;
            var month = new DateOnly(today.Year, today.Month, 1);
            yield return ("report_today", today, today);
            yield return ("report_yesterday", today.AddDays(-1), today.AddDays(-1));
            yield return ("report_7days", today.AddDays(-6), today);
            yield return ("an_30days", today.AddDays(-29), today);
            yield return ("report_month", month, today);
            yield return ("an_last_month", month.AddMonths(-1), month.AddDays(-1));
            yield return ("an_year", new DateOnly(today.Year, 1, 1), today);
        }
    }

    private AnalyticsFilter Filter => new(_from, _to,
        int.TryParse(_hall, out var h) ? h : null, int.TryParse(_waiter, out var w) ? w : null,
        Enum.TryParse<OrderType>(_type, out var t) ? t : null);

    private string PeriodText => CurrentPage == "payroll"
        ? new ReportBuilder(null!, L).MonthName(_payMonth)
        : _from == _to ? _from.ToString("dd.MM.yyyy") : _from.ToString("dd.MM.yyyy") + " — " + _to.ToString("dd.MM.yyyy") + "  (" + Filter.Days + " " + T("an_days") + ")";

    private string ExportHref => $"/{L}/r/{Rid}/export/{CurrentPage}?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&hall={_hall}&waiter={_waiter}&type={_type}&month={_payMonth:yyyy-MM-dd}";

    private string LangHref(string lang) => $"/lang/{lang}?to=" + Uri.EscapeDataString($"/{lang}/r/{Rid}/{CurrentPage}");

    private static string Icon(string page) => page switch
    {
        "overview" => "▤", "sales" => "◷", "payments" => "▭", "waiters" => "◉", "payroll" => "％",
        "tables" => "▦", "products" => "≡", "customers" => "☏", "control" => "⚠", _ => "▣"
    };

    protected override async Task OnInitializedAsync()
    {
        var state = Auth is null ? null : await Auth;
        if (!int.TryParse(state?.User.FindFirstValue(ClaimTypes.NameIdentifier), out var accountId))
        {
            Nav.NavigateTo($"/{L}/login", forceLoad: true);
            return;
        }
        _accountName = state!.User.Identity?.Name ?? "";
        _restaurants = await Accounts.RestaurantsForAsync(accountId);
        _restaurant = _restaurants.FirstOrDefault(r => r.Id == Rid);
        if (_restaurant is null)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        var today = RestaurantTime.Today;
        (_from, _to) = (today.AddDays(-6), today);
        (_fromInput, _toInput) = (_from, _to);
        _payMonth = new DateOnly(today.Year, today.Month, 1);

        await using var db = Tenants.Open(Rid);
        _halls = (await db.Halls.AsNoTracking().OrderBy(h => h.Name).Select(h => new { h.Id, h.Name }).ToListAsync()).Select(h => (h.Id, h.Name)).ToList();
        var waiterIds = await db.Orders.AsNoTracking().Select(o => o.WaiterId).Distinct().ToListAsync();
        _waiters = (await db.Users.AsNoTracking().Where(u => waiterIds.Contains(u.Id)).OrderBy(u => u.FullName).Select(u => new { u.Id, u.FullName }).ToListAsync())
            .Select(u => (u.Id, u.FullName)).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_restaurant is null) return;
        if (_loadedFor == CurrentPage) return;
        _loadedFor = CurrentPage;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _detail = null;
        StateHasChanged();
        try
        {
            await using var db = Tenants.Open(Rid);
            _built = await new ReportBuilder(db, L).BuildAsync(CurrentPage, Filter, _payMonth);
        }
        catch (ValidationException ex) { _error = T("v_" + ex.Message); }
        catch (Exception ex) { _error = T("err_failed") + ex.Message; }
        _loading = false;
    }

    private async Task SetPeriod(DateOnly from, DateOnly to)
    {
        (_from, _to) = (from, to);
        (_fromInput, _toInput) = (from, to);
        await ReloadAsync();
    }

    private async Task ApplyDates()
    {
        if (_toInput < _fromInput) { _error = T("v_period_invalid"); return; }
        (_from, _to) = (_fromInput, _toInput);
        await ReloadAsync();
    }

    private async Task DrillAsync((string Kind, int Key) row)
    {
        await using var db = Tenants.Open(Rid);
        _detail = await new ReportBuilder(db, L).WaiterDetailAsync(Filter, row.Key, row.Kind == "payroll" ? _payMonth : null);
    }

    private async Task MonthAsync(int delta)
    {
        _payMonth = _payMonth.AddMonths(delta);
        await ReloadAsync();
    }

    private void SwitchRestaurant(ChangeEventArgs e) =>
        Nav.NavigateTo($"/{L}/r/{e.Value}/{CurrentPage}", forceLoad: true);
}
