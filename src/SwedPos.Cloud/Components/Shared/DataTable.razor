@using System.Data
@* A report table: sortable by clicking a column, numbers right-aligned in the app's format; rows open a detail when the table allows it. *@

@if (Block.Table.Data.Rows.Count == 0)
{
    <p class="dim">@Texts.Get(Lang, "an_no_data")</p>
}
else
{
    <div class="table-wrap">
        <table class="report">
            <thead>
                <tr>
                    @foreach (DataColumn c in Block.Table.Data.Columns)
                    {
                        var col = c;
                        <th class="@(Numeric(col) ? "num" : "")" @onclick="() => Sort(col.Ordinal)">
                            @col.Caption@(col.Ordinal == _sort ? (_desc ? " ▾" : " ▴") : "")
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var (row, index) in Rows())
                {
                    var key = Block.RowKeys is { } keys && index < keys.Count ? keys[index] : (int?)null;
                    <tr class="@(Block.Drill is not null ? "click" : "") @(key is not null && key == _picked ? "picked" : "")" @onclick="() => Pick(key)">
                        @foreach (DataColumn c in Block.Table.Data.Columns)
                        {
                            <td class="@(Numeric(c) ? "num" : "")">@Show(row[c], c)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public TableBlock Block { get; set; } = null!;
    [Parameter] public string Lang { get; set; } = "uz";
    [Parameter] public EventCallback<(string Kind, int Key)> OnDrill { get; set; }

    private int _sort = -1;
    private bool _desc;
    private int? _picked;

    protected override void OnParametersSet() { _sort = -1; _picked = null; }

    private static bool Numeric(DataColumn c) => ReportTable.KindOf(c) is ColumnKind.Money or ColumnKind.Integer or ColumnKind.Percent or ColumnKind.Number;

    private IEnumerable<(DataRow Row, int Index)> Rows()
    {
        var rows = Block.Table.Data.Rows.Cast<DataRow>().Select((r, i) => (r, i));
        if (_sort < 0) return rows;
        var sorted = rows.OrderBy(x => x.r[_sort] is DBNull ? null : x.r[_sort], Comparer<object?>.Create(CompareValues));
        return _desc ? sorted.Reverse() : sorted;
    }

    private static int CompareValues(object? a, object? b) => (a, b) switch
    {
        (null, null) => 0, (null, _) => -1, (_, null) => 1,
        (IComparable x, _) => x.CompareTo(b),
        _ => 0
    };

    private void Sort(int column)
    {
        if (_sort == column) _desc = !_desc;
        else { _sort = column; _desc = Numeric(Block.Table.Data.Columns[column]); }
    }

    private async Task Pick(int? key)
    {
        if (Block.Drill is null || key is null) return;
        _picked = key;
        await OnDrill.InvokeAsync((Block.Drill, key.Value));
    }

    private static string Show(object value, DataColumn c)
    {
        if (value is DBNull) return "—";
        return ReportTable.KindOf(c) switch
        {
            ColumnKind.Money or ColumnKind.Integer => Fmt.Money(Convert.ToDecimal(value)),
            ColumnKind.Percent => Fmt.Percent(Convert.ToDecimal(value)),
            ColumnKind.Number => Convert.ToDecimal(value).ToString("0.#", Fmt.Culture),
            ColumnKind.Date => ((DateTime)value).ToString("dd.MM.yyyy"),
            ColumnKind.DateTime => ((DateTime)value).ToString("dd.MM.yyyy HH:mm"),
            _ => value.ToString() ?? ""
        };
    }
}
