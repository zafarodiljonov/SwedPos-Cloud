@using System.Globalization
@* Weekday x hour grid: the darker brass, the more was sold. *@

<div class="heat">
    @for (var d = 0; d < 7; d++)
    {
        <span class="day">@Block.Days[d]</span>
        @for (var h = 0; h < 24; h++)
        {
            var cell = _cells.GetValueOrDefault((d, h));
            var alpha = cell is null || _max == 0 ? 0 : 0.16 + 0.84 * (double)(cell.Revenue / _max);
            <span class="cell @(cell is null ? "empty" : "")"
                  style="@(cell is null ? "" : "background:rgba(214,163,58," + alpha.ToString("0.00", CultureInfo.InvariantCulture) + ")")"
                  title="@($"{Block.Days[d]} {h:00}:00–{(h + 1) % 24:00}:00\n{Fmt.Money(cell?.Revenue ?? 0)}\n{Block.OrdersLabel}: {cell?.Orders ?? 0}")"></span>
        }
    }
    <span></span>
    @for (var h = 0; h < 24; h++)
    {
        <span class="hour">@(h % 3 == 0 ? h.ToString("00") : "")</span>
    }
</div>

@code {
    [Parameter] public HeatBlock Block { get; set; } = null!;
    private Dictionary<(int, int), SwedPos.Services.HeatCell> _cells = new();
    private decimal _max;

    protected override void OnParametersSet()
    {
        _cells = Block.Cells.ToDictionary(c => (c.Weekday, c.Hour));
        _max = Block.Cells.Count == 0 ? 0 : Block.Cells.Max(c => c.Revenue);
    }
}
