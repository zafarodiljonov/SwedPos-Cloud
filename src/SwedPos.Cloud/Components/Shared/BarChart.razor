@using System.Globalization
@* Vertical bars as SVG; the highest is full brass, the others muted; hover shows the values. *@

@if (Points.Count == 0)
{
    <p class="dim">@Texts.Get(Lang, "an_no_data")</p>
}
else
{
    <svg class="chart" viewBox="0 0 @W @H" preserveAspectRatio="xMidYMid meet" role="img">
        @foreach (var (value, y) in Grid())
        {
            <line class="grid" x1="@F(Left)" x2="@F(W - Right)" y1="@F(y)" y2="@F(y)" />
            @Txt(Left - 8, y + 4, "end", Fmt.Short(value, Lang))
        }
        @for (var i = 0; i < Points.Count; i++)
        {
            var p = Points[i];
            var h = _top == 0 ? 0 : (double)(p.Value / _top) * (Bottom - Top);
            <g class="bar @(p.Value == _max && _max > 0 ? "max" : "")">
                <rect class="hit" x="@F(Left + i * Slot)" y="@F(Top)" width="@F(Slot)" height="@F(Bottom - Top)" />
                <rect class="fill" x="@F(Left + i * Slot + (Slot - Bar) / 2)" y="@F(Bottom - h)" width="@F(Bar)" height="@F(Math.Max(h, 0))" />
                <title>@(p.Tooltip ?? p.Label + "\n" + Fmt.Money(p.Value))</title>
            </g>
            @if (i % Every == 0)
            {
                @Txt(Left + i * Slot + Slot / 2, H - 6, "middle", p.Label)
            }
        }
    </svg>
}

@code {
    [Parameter] public IReadOnlyList<Point> Points { get; set; } = Array.Empty<Point>();
    [Parameter] public string Lang { get; set; } = "uz";

    private const double W = 1000, H = 300, Left = 70, Right = 8, Top = 12, Bottom = 270;
    private decimal _top = 1, _step = 1, _max;

    protected override void OnParametersSet()
    {
        _max = Points.Count == 0 ? 0 : Points.Max(p => p.Value);
        (_top, _step) = ChartMath.NiceScale(_max);
    }

    private double Slot => (W - Left - Right) / Math.Max(1, Points.Count);
    private double Bar => Math.Max(3, Math.Min(56, Slot * 0.62));
    private int Every => Math.Max(1, (int)Math.Ceiling(Points.Count / 16.0));
    private IEnumerable<(decimal Value, double Y)> Grid() { for (var v = 0m; v <= _top; v += _step) yield return (v, Bottom - (double)(v / _top) * (Bottom - Top)); }
    private static MarkupString Txt(double x, double y, string anchor, string content) =>
        new($"<text class=\"axis\" x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}
