# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# Local dev (without DATABASE_URL a local SQLite file is used):
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgres://swedpos_cloud:YOUR_DB_PASSWORD@localhost:5432/swedpos_cloud

# Production only (leave unset locally):
# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=swedpos.django.group
# CSRF_TRUSTED_ORIGINS=https://swedpos.django.group
# DATABASE_URL=postgres://<ACCOUNT>:<DBPASSWORD>@127.0.0.1:5432/<ACCOUNT>_swedpos
#   (use an alphanumeric DB password - no @ : / # - so the URL stays valid)
